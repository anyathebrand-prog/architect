# Email — option 1 (no domain needed): send through a Gmail account
# GMAIL_APP_PASSWORD is a 16-character App Password, not your normal password:
# Google Account → Security → 2-Step Verification → App passwords
GMAIL_USER=
GMAIL_APP_PASSWORD=
STUDIO_INBOX=

# Email — option 2 (needs a verified domain): https://resend.com
RESEND_API_KEY=
EMAIL_FROM="ONWA STUDIO <bookings@onwastudio.com>"

# Optional: mirror bookings into Cal.com (calendar invites + reminder workflows)
CAL_API_KEY=
CAL_EVENT_TYPE_VIRTUAL=
CAL_EVENT_TYPE_STUDIO=
CAL_EVENT_TYPE_SITE=
