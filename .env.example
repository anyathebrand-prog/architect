# Optional: mirror bookings into Cal.com (calendar invites + reminder workflows)
CAL_API_KEY=
CAL_EVENT_TYPE_VIRTUAL=
CAL_EVENT_TYPE_STUDIO=
CAL_EVENT_TYPE_SITE=
